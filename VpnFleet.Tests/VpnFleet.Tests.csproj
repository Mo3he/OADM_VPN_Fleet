<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- test method names use underscores -->
    <NoWarn>$(NoWarn);CA1707;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <!-- The client host normally provides these at runtime; the tests bring them. -->
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.0" />
    <Using Include="Xunit" />
    <PackageReference Include="Oadm.Sdk.Client" Version="5.1.0" />
    <!-- A fake camera, device and the server's plugin contexts (NuGet: Oadm.Sdk.Testing). -->
    <PackageReference Include="Oadm.Sdk.Testing" Version="5.1.0" />
    <ProjectReference Include="..\VpnFleet\VpnFleet.csproj" />
    <ProjectReference Include="..\VpnFleet.Client\VpnFleet.Client.csproj" />
  </ItemGroup>
</Project>
